# Environment Configuration
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Auth & Cryptography
JWT_SECRET_KEY=generate_a_random_sha256_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
EVIDENCE_ENCRYPTION_SECRET=master_encryption_secret_phrase
EVIDENCE_SALT=static_salt_value_change_in_production

# Blockchain Data Pipeline (Sepolia Testnet)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
